# Optional local LLM for AI explanations (Ollama).
# PatchPilot works without these — if Ollama is unreachable the app falls back
# to deterministic explanations. No API key is required.

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Request timeout in milliseconds (default 20000).
# OLLAMA_TIMEOUT_MS=20000

# Optional. Live CISA KEV / EPSS / NVD enrichment works with no credentials.
# An NVD key only raises the rate limit: https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=

# Optional. Leave unset to use the built-in Next.js API routes (single process).
# Set this to use the standalone backend/ service instead.
# NEXT_PUBLIC_API_URL=http://localhost:8000
