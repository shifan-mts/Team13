# Port for the standalone API service (default 8000).
# PORT=8000

# Optional local LLM — shared with the frontend's AI layer.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# OLLAMA_TIMEOUT_MS=20000

# Optional. Only raises the NVD rate limit; live feeds work without it.
# NVD_API_KEY=
